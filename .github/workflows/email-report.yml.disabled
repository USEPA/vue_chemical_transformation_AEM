name: email 

on:
  schedule:
    - cron: '00 9 * * 1,4'
  workflow_dispatch:
    
env:
    REPORT_DIR: /data/watchtower/chet/container-results/chet-ui

jobs:
    send-email:
        runs-on: "th879"
        steps:
        - name: Email latest report
          uses: USEPA/email-report@main
          with:
                report_path: ${{ env.REPORT_DIR }}/chet-vue-report.html
                recipients: ${{ vars.REPORT_RECIPIENTS }}
                sender: ${{ vars.REPORT_SENDER }}
                subject: "chet-vue container scanning results"
                body: |
                    Hello,

                    Please find attached the chet-vue container scan report.

                    Best regards.